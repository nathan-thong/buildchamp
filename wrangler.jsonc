{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buildchamp",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBIES",
        "class_name": "BuildChampLobby",
      },
      {
        "name": "IDENTITIES",
        "class_name": "BuildChampBrowserIdentity",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BuildChampLobby"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BuildChampBrowserIdentity"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "env": {
    "preview": {
      "name": "buildchamp-preview",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          {
            "name": "LOBBIES",
            "class_name": "BuildChampLobby",
          },
        {
          "name": "IDENTITIES",
          "class_name": "BuildChampBrowserIdentity",
        },
        ],
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
    },
  },
}
